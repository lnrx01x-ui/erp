DJANGO_SECRET_KEY=replace-this-for-any-shared-environment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: postgresql://erp:erp@localhost:5432/erp
DATABASE_URL=
PUBLIC_APP_URL=http://localhost:5173
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=no-reply@nasaq.local
# Set true only when a trusted reverse proxy overwrites X-Forwarded-Proto.
DJANGO_BEHIND_TRUSTED_HTTPS_PROXY=False
